{
  "info": {
    "name": "Seminário Sinatra — API de tarefas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Execute as pastas em ordem com banco vazio. Entre Preparar persistência e Conferir persistência, encerre e reinicie o servidor. A coleção cria e exclui somente suas próprias tarefas."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:4567"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code === 204) {",
          "  pm.test('Resposta sem corpo', () => pm.expect(pm.response.text()).to.eql(''));",
          "} else {",
          "  pm.test('Resposta JSON válida', () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); pm.response.json(); });",
          "}",
          "if (pm.response.code >= 400) {",
          "  pm.test('Erro JSON consistente', () => { pm.expect(pm.response.json()).to.have.all.keys('error'); pm.expect(pm.response.json().error).to.be.a('string').and.not.empty; });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "CRUD e validações",
      "item": [
        {
          "name": "Listar banco vazio",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Dados esperados', () => { pm.expect(pm.response.json()).to.eql([]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar tarefa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"  Estudar Sinatra  \"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Dados esperados', () => { const task = pm.response.json(); pm.expect(task).to.have.all.keys('id', 'title', 'completed'); pm.expect(task.id).to.be.a('number'); pm.expect(task.title).to.eql('Estudar Sinatra'); pm.expect(task.completed).to.eql(false); pm.collectionVariables.set('task_id', task.id); });"
                ]
              }
            }
          ]
        },
